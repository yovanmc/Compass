<Application x:Class="Compass.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Compass.App"
             xmlns:ui="clr-namespace:Wpf.Ui.Markup;assembly=Wpf.Ui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <local:PathToImageConverter x:Key="PathToImageConverter"/>
            <local:FractionToWidthConverter x:Key="FractionToWidth"/>
            <local:NullToVisibilityConverter x:Key="NullToVis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- WPF-UI hosts pages in a DynamicScrollViewer that measures at INFINITE height, which
                 defeats list virtualization (multi-second freeze on a large library) and leaves the
                 page nothing to scroll. Binding MaxHeight to that ScrollViewer's ViewportHeight lets
                 each page's own ListBox / ScrollViewer virtualize and scroll. -->
            <Style x:Key="NavPageStyle" TargetType="{x:Type Page}">
                <Setter Property="MaxHeight"
                        Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
